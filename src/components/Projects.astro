---
import { projects, SlideKind } from '../data/site';

const mediaClass =
  'absolute inset-0 h-full w-full object-cover transition-transform duration-700 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:scale-105';
---

<section id="proyectos" class="relative px-6 py-24 lg:px-10 lg:py-36">
  <div class="mx-auto max-w-7xl">
    <div class="reveal mb-16 flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
      <h2 class="font-display text-h2 font-bold">
        Marcas que ya<br />están en órbita
      </h2>
      <p class="max-w-sm text-muted">
        Una selección de proyectos, uno por cada cosa que hacemos. De Tiendanube a pauta,
        de shootings a e-mail marketing.
      </p>
    </div>

    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 md:grid-cols-3 lg:gap-6">
      {
        projects.map((project, i) => (
          <article
            data-cursor
            class:list={[
              'group reveal relative overflow-hidden rounded-2xl border border-white/10',
              // uniform stack on mobile; editorial layout only from md up:
              //   idx 0 → tall photo (spans two rows)
              //   idx 5 → wide landscape banner (spans all three columns)
              //   rest → square. Fills the block with no leftover gap.
              i === 0
                ? 'aspect-[16/10] sm:aspect-square md:row-span-2 md:aspect-auto'
                : i === 5
                  ? 'aspect-[16/10] sm:aspect-square md:col-span-3 md:aspect-[21/9]'
                  : 'aspect-[16/10] sm:aspect-square',
            ]}
          >
            <div
              class:list={['absolute inset-0 bg-gradient-to-br', project.tint]}
            />
            {project.video && (
              <video
                src={project.video}
                poster={project.poster}
                autoplay
                muted
                loop
                playsinline
                preload="metadata"
                class={mediaClass}
              />
            )}
            {project.slides && (
              <div data-slideshow class={mediaClass}>
                {project.slides.map((slide, slideIndex) =>
                  slide.kind === SlideKind.Video ? (
                    <video
                      data-slide
                      src={slide.src}
                      muted
                      playsinline
                      preload="none"
                      class="slide absolute inset-0 h-full w-full object-cover"
                    />
                  ) : (
                    <img
                      data-slide
                      src={slide.src}
                      alt=""
                      loading={slideIndex === 0 ? 'eager' : 'lazy'}
                      decoding="async"
                      class="slide absolute inset-0 h-full w-full object-cover"
                    />
                  ),
                )}
                <div class="absolute inset-x-5 top-5 z-10 flex gap-1" aria-hidden="true">
                  {project.slides.map(() => (
                    <span data-slide-dot class="slide-dot h-0.5 flex-1 rounded-full bg-white/25" />
                  ))}
                </div>
              </div>
            )}
            {project.badge && (
              <span class="classified-badge absolute left-4 top-4 z-10 rounded-full border border-yellow/60 bg-space/70 px-3 py-1 text-[0.65rem] font-semibold uppercase tracking-[0.2em] text-yellow backdrop-blur">
                {project.badge}
              </span>
            )}
            <div class="absolute inset-0 bg-space/20 transition-colors duration-500 group-hover:bg-space/0" />
            <div class="absolute inset-x-0 bottom-0 h-1/2 bg-gradient-to-t from-space/85 to-transparent" />

            <div class="absolute inset-0 flex flex-col justify-end p-5">
              <p class="translate-y-2 text-xs font-semibold uppercase tracking-wider text-yellow opacity-0 transition-all duration-500 group-hover:translate-y-0 group-hover:opacity-100">
                {project.service}
              </p>
              <h3 class="font-display text-xl font-semibold text-ink lg:text-2xl">
                {project.client}
              </h3>
            </div>

          </article>
        ))
      }
    </div>
  </div>
</section>

<script>
  import '../scripts/slideshow.js';
</script>
