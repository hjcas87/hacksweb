---
import { monthlyServices, oneShotServices } from '../data/site';
---

<section id="servicios" class="relative px-6 py-24 lg:px-10 lg:py-36">
  <!-- Brand sticker · sits behind the content, decorative only -->
  <img
    src="/brand/bolt.webp"
    alt=""
    aria-hidden="true"
    width="320"
    height="463"
    class="sticker-float pointer-events-none absolute right-4 top-10 hidden w-16 opacity-70 lg:block lg:w-24"
  />

  <div class="relative mx-auto max-w-7xl">
    <div class="reveal mb-16 flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
      <div>
        <p class="mb-4 flex items-center gap-3 text-xs font-semibold uppercase tracking-[0.25em] text-yellow">
          <span class="inline-block h-px w-10 bg-yellow"></span>
          Qué hacemos
        </p>
        <h2 class="font-display text-h2 font-bold">
          Servicios que<br />mueven la aguja
        </h2>
      </div>
      <p class="max-w-sm text-muted">
        Trabajamos por abono mensual para acompañarte a largo plazo, o con proyectos
        puntuales cuando necesitás un empujón específico.
      </p>
    </div>

    <!-- Monthly services · big interactive rows -->
    <p class="reveal mb-2 text-sm font-semibold uppercase tracking-wider text-muted">
      Servicios mensuales
    </p>
    <ul class="border-t border-white/10">
      {
        monthlyServices.map((service) => (
          <li
            data-cursor
            class="group reveal relative grid grid-cols-[auto_1fr] items-center gap-6 border-b border-white/10 py-7 transition-colors duration-500 hover:bg-white/[0.03] md:grid-cols-[6rem_1fr_1.5fr] md:py-9"
          >
            <span class="font-display text-sm text-muted transition-colors group-hover:text-yellow md:text-base">
              {service.id}
            </span>
            <h3 class="font-display text-h3 font-semibold transition-transform duration-500 group-hover:translate-x-2">
              {service.title}
            </h3>
            <p class="col-span-2 text-pretty text-muted md:col-span-1 md:opacity-60 md:transition-opacity md:duration-500 md:group-hover:opacity-100">
              {service.desc}
            </p>
          </li>
        ))
      }
    </ul>

    <!-- One-shot services · same interactive row style as the monthly list -->
    <div class="mt-20">
      <p class="reveal mb-2 text-sm font-semibold uppercase tracking-wider text-muted">
        Proyectos one-shot
      </p>
      <ul class="border-t border-white/10">
        {
          oneShotServices.map((service) => (
            <li
              data-cursor
              class="group reveal grid grid-cols-[auto_1fr] items-center gap-6 border-b border-white/10 py-6 transition-colors duration-500 hover:bg-white/[0.03] md:grid-cols-[6rem_1fr] md:py-7"
            >
              <span class="font-display text-sm text-muted transition-colors group-hover:text-yellow md:text-base">
                {service.id}
              </span>
              <h3 class="font-display text-h3 font-semibold transition-transform duration-500 group-hover:translate-x-2">
                {service.title}
              </h3>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
