---
import { partners } from '../data/site';
---

<section aria-label="Partners" class="relative px-6 pb-24 lg:px-10 lg:pb-32">
  <div
    class="reveal relative mx-auto flex max-w-5xl flex-col items-center gap-7 px-6 pt-14 text-center"
  >
    <!-- brand hairline glow — the only framing we keep -->
    <div
      class="pointer-events-none absolute inset-x-0 top-0 h-px"
      style="background-image: linear-gradient(90deg, transparent, rgba(228,210,233,0.6), rgba(245,220,137,0.6), transparent);"
    >
    </div>

    <p class="text-xs font-semibold uppercase tracking-[0.3em] text-yellow">
      Partners oficiales
    </p>

    <!-- HACKS ✕ Tiendanube lockup -->
    <div class="flex flex-wrap items-center justify-center gap-6 sm:gap-9">
      <img
        src="/brand/logo-hacks.webp"
        alt="HACKS"
        width="720"
        height="398"
        class="h-11 w-auto sm:h-14"
      />
      <span class="text-2xl font-light text-muted">✕</span>
      <a
        href={partners.tiendanube.url}
        target="_blank"
        rel="noopener"
        data-magnetic="0.2"
        aria-label={partners.tiendanube.label}
        class="inline-flex transition-transform hover:scale-[1.03]"
      >
        <img
          src={partners.tiendanube.badge}
          alt={partners.tiendanube.label}
          width="1250"
          height="469"
          class="h-12 w-auto sm:h-14"
        />
      </a>
    </div>

    <p class="max-w-lg text-muted">
      Somos <span class="font-semibold text-ink">Partners Expert certificados de Tiendanube</span>:
      montamos, migramos y potenciamos tu tienda para que venda de verdad.
    </p>
  </div>
</section>
