---
interface Props {
  quote: string;
  author: string;
  handle: string;
}

const { quote, author, handle } = Astro.props;

// The @handle is the client's Instagram — link straight to the profile.
const profileUrl = `https://www.instagram.com/${handle.replace(/^@/, '')}`;
---

<figure
  data-cursor
  class="flex w-[85vw] shrink-0 flex-col justify-between gap-6 rounded-3xl border border-white/10 bg-space-2/60 p-7 backdrop-blur-sm transition-colors duration-500 hover:border-white/25 sm:w-[26rem]"
>
  <blockquote class="text-[15px] leading-relaxed text-ink/90">“{quote}”</blockquote>
  <figcaption class="flex items-center gap-3">
    <span
      class="flex h-10 w-10 items-center justify-center rounded-full bg-gradient-to-br from-lila to-yellow font-display text-sm font-bold text-space"
    >
      {author.charAt(0)}
    </span>
    <div>
      <p class="font-display text-sm font-semibold">{author}</p>
      <a
        href={profileUrl}
        target="_blank"
        rel="noopener"
        class="link-underline text-xs text-muted transition-colors hover:text-yellow"
      >
        {handle}
      </a>
    </div>
  </figcaption>
</figure>
