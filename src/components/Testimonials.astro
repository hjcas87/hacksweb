---
import { testimonials } from '../data/site';
import TestimonialCard from './TestimonialCard.astro';

const mid = Math.ceil(testimonials.length / 2);
const rowA = testimonials.slice(0, mid);
const rowB = testimonials.slice(mid);
---

<section class="relative overflow-hidden py-24 lg:py-36">
  <div class="mx-auto mb-16 max-w-7xl px-6 lg:px-10">
    <p class="reveal mb-4 flex items-center gap-3 text-xs font-semibold uppercase tracking-[0.25em] text-lime">
      <span class="inline-block h-px w-10 bg-lime"></span>
      Lo que dicen de nosotros
    </p>
    <h2 class="reveal font-display text-4xl font-bold leading-none tracking-tight lg:text-6xl">
      Marcas que nos<br />eligen y se quedan
    </h2>
  </div>

  <!-- Row A -->
  <div class="marquee-track relative flex overflow-hidden">
    <div class="marquee gap-5 pr-5" style="--duration: 55s;">
      {[...rowA, ...rowA].map((t) => <TestimonialCard {...t} />)}
    </div>
  </div>

  <!-- Row B (reverse) -->
  <div class="marquee-track relative mt-5 flex overflow-hidden">
    <div class="marquee reverse gap-5 pr-5" style="--duration: 65s;">
      {[...rowB, ...rowB].map((t) => <TestimonialCard {...t} />)}
    </div>
  </div>
</section>
