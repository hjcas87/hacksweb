---
import { contact, motto } from '../data/site';

const whatsappUrl = `https://wa.me/${contact.whatsapp}`;
const mailtoUrl = `mailto:${contact.email}`;
---

<section id="contacto" class="relative overflow-hidden px-6 py-28 text-center lg:px-10 lg:py-44">
  <!-- Brand gradient from the kit, stretched edge to edge as a soft glow behind the
       CTA. Stretched (not cropped) so lila -> yellow runs across the full width, and
       radially masked so it fades out instead of ending on a hard edge. -->
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-x-[-10%] top-1/2 h-[38rem] -translate-y-1/2 opacity-35 mix-blend-screen blur-[110px]"
    style="background-image: url('/brand/gradient-overlay.webp'); background-size: 100% 100%; -webkit-mask-image: radial-gradient(60% 58% at 50% 50%, #000 0%, transparent 100%); mask-image: radial-gradient(60% 58% at 50% 50%, #000 0%, transparent 100%);"
  >
  </div>

  <div class="relative mx-auto max-w-4xl">
    <img
      src="/brand/rocket.png"
      alt=""
      aria-hidden="true"
      width="192"
      height="192"
      class="reveal mx-auto mb-6 h-16 w-16 lg:h-20 lg:w-20"
    />
    <h2 class="reveal font-display text-display font-bold">
      ¿Listos para<br />
      <span class="text-brand-gradient">despegar?</span>
    </h2>
    <p class="reveal mx-auto mt-8 max-w-xl text-lead text-muted">
      Contanos qué necesita tu marca y armamos el plan para llevarla a otra órbita.
      Primera charla sin costo.
    </p>

    <div class="reveal mt-12 flex flex-wrap items-center justify-center gap-4">
      <a
        href={whatsappUrl}
        target="_blank"
        rel="noopener"
        data-magnetic="0.4"
        class="group inline-flex items-center gap-2 rounded-full bg-yellow px-8 py-4 font-display text-lg font-semibold text-space transition-transform hover:scale-[1.03]"
      >
        Escribinos por WhatsApp
        <span class="transition-transform duration-300 group-hover:translate-x-1">→</span>
      </a>
      <a
        href={mailtoUrl}
        class="link-underline inline-flex items-center gap-2 px-3 py-4 text-lg font-medium"
      >
        {contact.email}
      </a>
    </div>

    <p class="reveal mt-16 font-display text-h3 font-semibold">
      <span class="text-brand-gradient">{motto}</span>
    </p>
  </div>
</section>
