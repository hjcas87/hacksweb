---
import { contact } from '../data/site';

const whatsappUrl = `https://wa.me/${contact.whatsapp}`;
const mailtoUrl = `mailto:${contact.email}`;
---

<section id="contacto" class="relative px-6 py-28 text-center lg:px-10 lg:py-44">
  <div class="mx-auto max-w-4xl">
    <p class="reveal mb-6 text-6xl">🚀</p>
    <h2 class="reveal font-display text-[clamp(2.5rem,8vw,6rem)] font-bold leading-[0.95] tracking-tight">
      ¿Listos para<br />
      <span class="bg-gradient-to-r from-violet via-cyan to-lime bg-clip-text text-transparent">
        despegar?
      </span>
    </h2>
    <p class="reveal mx-auto mt-8 max-w-xl text-lg text-muted">
      Contanos qué necesita tu marca y armamos el plan para llevarla a otra órbita.
      Primera charla sin costo.
    </p>

    <div class="reveal mt-12 flex flex-wrap items-center justify-center gap-4">
      <a
        href={whatsappUrl}
        target="_blank"
        rel="noopener"
        data-magnetic="0.4"
        class="group inline-flex items-center gap-2 rounded-full bg-lime px-8 py-4 font-display text-lg font-semibold text-space transition-transform hover:scale-[1.03]"
      >
        Escribinos por WhatsApp
        <span class="transition-transform duration-300 group-hover:translate-x-1">→</span>
      </a>
      <a
        href={mailtoUrl}
        class="link-underline inline-flex items-center gap-2 px-3 py-4 text-lg font-medium"
      >
        {contact.email}
      </a>
    </div>
  </div>
</section>
