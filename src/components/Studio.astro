---
import { studio } from '../data/site';

// Duplicate the set so the -50% marquee keyframe loops seamlessly.
const strip = [...studio.photos, ...studio.photos];
---

<section id="estudio" class="relative py-24 lg:py-32">
  <div class="mx-auto max-w-7xl px-6 lg:px-10">
    <div class="reveal mb-10 flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
      <div>
        <p class="mb-4 flex items-center gap-3 text-xs font-semibold uppercase tracking-[0.25em] text-yellow">
          <span class="inline-block h-px w-10 bg-yellow"></span>
          {studio.handle}
        </p>
        <h2 class="font-display text-h2 font-bold">{studio.title}</h2>
      </div>
      <p class="max-w-md text-muted">{studio.desc}</p>
    </div>
  </div>

  <!-- Compact auto-scrolling filmstrip. Pauses on hover; loops seamlessly. -->
  <div class="marquee-track reveal relative overflow-hidden">
    <div class="marquee" style="--duration: 55s;">
      {
        strip.map((photo) => (
          <div class="mr-4 h-48 w-72 shrink-0 overflow-hidden rounded-2xl border border-white/10 sm:h-60 sm:w-[22rem]">
            <img
              src={photo.src}
              alt={photo.alt}
              loading="lazy"
              class="h-full w-full object-cover"
            />
          </div>
        ))
      }
    </div>
    <!-- edge fades so the strip melts into the section -->
    <div
      class="pointer-events-none absolute inset-y-0 left-0 z-10 w-16 bg-gradient-to-r from-space to-transparent lg:w-28"
    >
    </div>
    <div
      class="pointer-events-none absolute inset-y-0 right-0 z-10 w-16 bg-gradient-to-l from-space to-transparent lg:w-28"
    >
    </div>
  </div>

  <div class="mx-auto mt-10 flex max-w-7xl justify-center px-6 md:justify-start lg:px-10">
    <a
      href={studio.url}
      target="_blank"
      rel="noopener"
      data-magnetic="0.35"
      class="group inline-flex items-center gap-2.5 rounded-full bg-yellow px-7 py-3.5 font-display font-semibold text-space transition-transform hover:scale-[1.03]"
    >
      <svg
        viewBox="0 0 24 24"
        aria-hidden="true"
        class="h-5 w-5"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <rect x="2" y="2" width="20" height="20" rx="5" />
        <circle cx="12" cy="12" r="4" />
        <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none" />
      </svg>
      Seguinos en Instagram
      <span class="transition-transform duration-300 group-hover:translate-x-1">→</span>
    </a>
  </div>
</section>
