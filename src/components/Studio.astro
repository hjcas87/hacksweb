---
import { studio } from '../data/site';

// Editorial mosaic: two tall portraits framing two stacked landscapes.
// Mobile falls back to a simple stacked feed. Classes are per-tile so the
// layout stays deterministic (no masonry guesswork).
const mobileClass = [
  'col-span-2 aspect-[16/10]', // placa — wide banner
  'aspect-square',
  'aspect-square',
  'col-span-2 aspect-[16/10]',
];
const mdClass = [
  'md:col-start-1 md:row-start-1 md:row-span-2 md:aspect-auto md:h-full',
  'md:col-start-2 md:col-span-2 md:row-start-1 md:aspect-auto md:h-full',
  'md:col-start-2 md:col-span-2 md:row-start-2 md:aspect-auto md:h-full',
  'md:col-start-4 md:row-start-1 md:row-span-2 md:aspect-auto md:h-full',
];
---

<section id="estudio" class="relative px-6 py-24 lg:px-10 lg:py-36">
  <div class="mx-auto max-w-7xl">
    <div class="reveal mb-12 flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
      <div>
        <p class="mb-4 flex items-center gap-3 text-xs font-semibold uppercase tracking-[0.25em] text-yellow">
          <span class="inline-block h-px w-10 bg-yellow"></span>
          {studio.handle}
        </p>
        <h2 class="font-display text-h2 font-bold">{studio.title}</h2>
      </div>
      <p class="max-w-md text-muted">{studio.desc}</p>
    </div>

    <!-- Photo mosaic -->
    <div class="grid grid-cols-2 gap-3 sm:gap-4 md:h-[34rem] md:grid-cols-4 md:grid-rows-2">
      {
        studio.photos.map((photo, i) => (
          <a
            href={studio.url}
            target="_blank"
            rel="noopener"
            data-cursor
            aria-label={`Ver ${studio.handle} en Instagram`}
            class:list={[
              'group reveal relative overflow-hidden rounded-2xl border border-white/10',
              mobileClass[i],
              mdClass[i],
            ]}
          >
            <img
              src={photo.src}
              alt={photo.alt}
              loading="lazy"
              class="h-full w-full object-cover transition-transform duration-700 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:scale-105"
            />
            {/* hover wash + IG glyph */}
            <div class="absolute inset-0 bg-gradient-to-t from-space/70 via-space/10 to-transparent opacity-0 transition-opacity duration-500 group-hover:opacity-100" />
            <svg
              viewBox="0 0 24 24"
              aria-hidden="true"
              class="absolute right-4 top-4 h-6 w-6 translate-y-1 text-ink opacity-0 transition-all duration-500 group-hover:translate-y-0 group-hover:opacity-100"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <rect x="2" y="2" width="20" height="20" rx="5" />
              <circle cx="12" cy="12" r="4" />
              <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none" />
            </svg>
            {i === 0 && (
              <span class="absolute bottom-4 left-4 rounded-full bg-space/70 px-4 py-2 font-display text-sm font-semibold text-ink backdrop-blur-sm">
                {studio.handle}
              </span>
            )}
          </a>
        ))
      }
    </div>

    <div class="reveal mt-10 flex justify-center md:justify-start">
      <a
        href={studio.url}
        target="_blank"
        rel="noopener"
        data-magnetic="0.35"
        class="group inline-flex items-center gap-2.5 rounded-full bg-yellow px-7 py-3.5 font-display font-semibold text-space transition-transform hover:scale-[1.03]"
      >
        <svg
          viewBox="0 0 24 24"
          aria-hidden="true"
          class="h-5 w-5"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <rect x="2" y="2" width="20" height="20" rx="5" />
          <circle cx="12" cy="12" r="4" />
          <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none" />
        </svg>
        Seguinos en Instagram
        <span class="transition-transform duration-300 group-hover:translate-x-1">→</span>
      </a>
    </div>
  </div>
</section>
