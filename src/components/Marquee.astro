---
import { marqueeItems } from '../data/site';

// Duplicate the list so the -50% keyframe loops seamlessly.
const items = [...marqueeItems, ...marqueeItems];
---

<section aria-hidden="true" class="marquee-track relative overflow-hidden border-y border-white/5 py-6">
  <!-- Brand aurora behind the moving words: a lila glow bleeding from the left,
       a yellow glow from the right, black breathing through the middle so it
       reads as a real gradient (not a flat tint). -->
  <div
    class="pointer-events-none absolute inset-0"
    style="background-image: radial-gradient(75% 160% at 0% 50%, rgba(228,210,233,0.5) 0%, transparent 55%), radial-gradient(75% 160% at 100% 50%, rgba(245,220,137,0.5) 0%, transparent 55%);"
  >
  </div>
  <div class="marquee relative" style="--duration: 32s;">
    {
      items.map((item, i) => (
        <div class="flex items-center gap-6 px-6">
          <span class="font-display text-2xl font-medium text-ink/80 lg:text-4xl">{item}</span>
          {/* Brand separator: the play-triangle from the kit, alternating solid / outline */}
          <svg
            viewBox="0 0 14 16"
            class="h-4 w-3.5 shrink-0 text-yellow"
            fill={i % 2 === 0 ? 'currentColor' : 'none'}
            stroke="currentColor"
            stroke-width="2"
            aria-hidden="true"
          >
            <path d="M1.5 1.5 L12.5 8 L1.5 14.5 Z" />
          </svg>
        </div>
      ))
    }
  </div>
</section>
